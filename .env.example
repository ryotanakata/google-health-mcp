PORT=8080
# MCPサーバーの公開URL（オリジンのみ・末尾スラッシュなし）。Cloud Runのデプロイ後に発行されるURLを設定する
# ローカル確認時は http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
# OAuth同意画面で入力するパスフレーズ兼トークン署名鍵の元。十分に長いランダム値にする（例: openssl rand -hex 32）
# 変更すると発行済みのトークンがすべて無効になる
MCP_SHARED_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
